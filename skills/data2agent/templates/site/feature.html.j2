{% extends "base.html.j2" %}
{% block content %}
<h1>{{ feats.label_singular }} lookup</h1>
<div class="search" style="max-width:560px;margin:8px 0 18px">
  <input class="input" id="feat-search" type="search" placeholder="Search {{ "{:,}".format(feats.rows) }} {{ feats.label | lower }} by symbol or id" autocomplete="off" aria-label="Search {{ feats.label }}">
  <div class="suggest" id="feat-suggest" role="listbox"></div>
</div>
<div id="feat-empty" class="empty">Type a {{ feats.label_singular | lower }} above, or try <span id="feat-examples"></span>.</div>
<div id="feat-detail" class="stack" hidden>
  <div class="card">
    <div class="card-head"><h2 id="feat-title"></h2><span class="row small" id="feat-badges"></span></div>
    <dl class="kv" id="feat-kv"></dl>
  </div>
  <div class="grid grid-2">
    <div class="card">
      <div class="card-head"><h3>Expression by {{ primary.label if primary else 'group' }}</h3><span class="muted small" id="feat-value-label"></span></div>
      <div id="feat-group-chart" class="chart"></div>
    </div>
    <div class="card">
      <div class="card-head"><h3>Mean and fraction expressing</h3><span class="muted small">bubble size = fraction with value &gt; 0</span></div>
      <div id="feat-dot-chart" class="chart"></div>
    </div>
  </div>
  {% if m.embeddings %}
  <div class="card">
    <div class="card-head"><h3>Expression on map</h3><label class="small">Embedding <select id="feat-emb">{% for e in m.embeddings %}<option value="{{ e.name }}">{{ e.label or e.name }}</option>{% endfor %}</select></label></div>
    <div id="feat-emb-chart" class="chart tall"></div>
  </div>
  {% endif %}
  {% if m.results %}
  <div class="card tight">
    <div class="card-head"><h3>Hits in result tables</h3></div>
    <div class="table-wrap"><table class="data" id="feat-results"><thead></thead><tbody></tbody></table></div>
  </div>
  {% endif %}
</div>
{% endblock %}
