{% extends "base.html.j2" %}
{% block content %}
<h1>Query &amp; API</h1>
<p class="muted">Three ways in: an SQL console in the browser, an MCP server for AI agents, and plain Parquet files for any language.</p>

<div class="card">
  <div class="card-head"><h2>SQL console</h2><span class="muted small">read-only · DuckDB · 1,000 rows max</span></div>
  <textarea id="sql-input" rows="4" style="width:100%;font-family:var(--font-mono);font-size:.9rem" spellcheck="false">{% if obs %}select {{ primary.name if primary else obs.id }}, count(*) as n from obs group by 1 order by n desc{% elif m.figures %}select * from fig_{{ m.figures[0].panels[0].id }} limit 50{% else %}select * from {{ (m.tables.keys() | list)[0] }} limit 50{% endif %}</textarea>
  <div class="row" style="margin-top:8px">
    <button class="btn primary" id="sql-run">Run (Ctrl+Enter)</button>
    <span class="muted small" id="sql-status"></span>
    <span class="grow"></span>
    <button class="btn small" id="sql-csv" disabled>Export CSV</button>
  </div>
  <div class="table-wrap" style="max-height:420px;margin-top:10px"><table class="data" id="sql-table"><thead></thead><tbody></tbody></table></div>
  <h3 style="margin-top:14px">Examples</h3>
  <div class="row" id="sql-examples">
    {% if obs %}<button class="btn small" data-sql="select * from obs limit 20">First rows of obs</button>{% endif %}
    {% if feats %}<button class="btn small" data-sql="select * from features where symbol ilike 'CD3%' limit 50">Find features</button>{% endif %}
    {% if m.figures %}<button class="btn small" data-sql="select * from fig_{{ m.figures[0].panels[0].id }} limit 50">A figure panel</button>{% endif %}
    {% if m.matrices and primary %}<button class="btn small" data-sql="select o.{{ primary.name }} as grp, avg(m.value) as mean_value, count(*) as n_nonzero from matrix m join obs o using (obs_id) where m.feature_id = '{{ portal.example_feature or 'GENE' }}' group by 1 order by 2 desc">Expression by group</button>{% endif %}
    {% if m.results %}<button class="btn small" data-sql="select * from res_{{ m.results[0].name }} order by {{ m.results[0].score_col or m.results[0].columns[0].name }} desc limit 50">Top results</button>{% endif %}
  </div>
</div>

<div class="grid grid-2" style="margin-top:16px">
  <div class="card">
    <div class="card-head"><h2>MCP for AI agents</h2></div>
    <p class="small">Any MCP-compatible agent (Claude Code, Codex, Gemini CLI) can query this dataset with natural language. Download the package, then register the server:</p>
    <pre class="code">claude mcp add {{ m.id }} -- portal mcp ./{{ m.id }}-portal</pre>
    <p class="small muted">Tools exposed: <code>describe_tables</code>, <code>sql</code> (read-only), <code>search_features</code>, <code>get_obs</code>, <code>feature_summary</code>. The <code>portal</code> binary is in the package for hosted builds, or on the <a href="https://github.com/xuzhougeng/data2agent/releases">releases page</a>.</p>
  </div>
  <div class="card">
    <div class="card-head"><h2>Tables</h2></div>
    <dl class="kv small">
      {% for name, t in m.tables.items() %}<dt><code>{{ name }}</code></dt><dd>{{ t.label }} · {{ "{:,}".format(t.rows) }} rows · key <code>{{ t.id }}</code></dd>{% endfor %}
      {% for x in m.matrices %}<dt><code>{{ 'matrix' if loop.first else 'matrix_' ~ x.name }}</code></dt><dd>{{ x.label or x.name }} · <code>obs_id, feature_id, value</code> · {{ x.value.label or x.value.kind }}{% if x.features and x.features != 'features' %} · feature_id → <code>{{ x.features }}</code>{% endif %}{% if x.sparse %} · absent pairs are 0{% endif %}</dd>{% endfor %}
      {% for e in m.embeddings %}<dt><code>emb_{{ e.name }}</code></dt><dd>{{ e.label or e.name }} · <code>obs_id, x, y</code></dd>{% endfor %}
      {% for r in m.results %}<dt><code>res_{{ r.name }}</code></dt><dd>{{ r.label }} · {{ "{:,}".format(r.rows or 0) }} rows</dd>{% endfor %}
      {% for g in m.aggregates %}<dt><code>agg_{{ g.name }}</code></dt><dd>{{ g.description or g.name }}</dd>{% endfor %}
      {% for f in m.figures %}{% for p in f.panels %}<dt><code>fig_{{ p.id }}</code></dt><dd>{{ f.label }} · {{ p.label }} · {{ "{:,}".format(p.rows) }} rows</dd>{% endfor %}{% endfor %}
    </dl>
    <p class="small muted" style="margin-top:10px">Full column dictionary on the <a href="help.html#columns">Help</a> page.</p>
  </div>
</div>
{% if m.deploy and m.deploy.target == 'hosted' %}
<div class="card" style="margin-top:16px">
  <div class="card-head"><h2>HTTP API</h2></div>
  <p class="small">This portal is hosted; the same named queries the pages use are available at <code>{{ m.deploy.api_base_url }}</code>. Contract: <a href="assets/api-contract.json">api-contract.json</a>.</p>
  <pre class="code">{% if feats %}curl '{{ m.deploy.api_base_url }}/features/search?q=CD3&amp;limit=5'
curl '{{ m.deploy.api_base_url }}/matrix/feature/{{ portal.example_feature or 'GENE' }}'
{% endif %}{% if obs %}curl '{{ m.deploy.api_base_url }}/obs/count?filters={"{{ primary.name if primary else obs.id }}":["..."]}'
{% endif %}{% if m.figures %}curl '{{ m.deploy.api_base_url }}/figure/{{ m.figures[0].panels[0].id }}'
{% endif %}curl -X POST '{{ m.deploy.api_base_url }}/sql' -d '{"query":"select count(*) from {{ 'obs' if obs else 'fig_' ~ m.figures[0].panels[0].id if m.figures else (m.tables.keys() | list)[0] }}"}'</pre>
  <p class="small muted">Paths are relative to this page. Every list endpoint returns <code>{"columns": [...], "rows": [...]}</code>; filters and order are JSON in the query string.</p>
</div>
{% endif %}
{% endblock %}
