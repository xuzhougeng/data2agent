{% extends "base.html.j2" %}
{% block content %}
<h1>Download</h1>
<p class="muted">Every table in this portal is a Parquet file. Checksums are SHA-256 of the file bytes and match <code>manifest.json</code>.{% if m.license %} License: {{ m.license }}.{% endif %}</p>

<div class="card tight">
  <div class="card-head" style="padding:6px 6px 0"><h2>Processed tables</h2><a class="btn small" href="manifest.json" download>manifest.json</a></div>
  <div class="table-wrap"><table class="data">
    <thead><tr><th>File</th><th>Contents</th><th class="num">Rows</th><th class="num">Size</th><th>SHA-256</th></tr></thead>
    <tbody>
    {% for name, t in m.tables.items() %}
      <tr><td><a href="{{ t.path }}" download>{{ t.path }}</a></td><td class="wrap">{{ t.label }} ({{ t.columns | length }} columns)</td><td class="num">{{ "{:,}".format(t.rows) }}</td><td class="num">{{ m.files[t.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[t.path].sha256 }}">{{ m.files[t.path].sha256[:12] }}…</td></tr>
    {% endfor %}
    {% for x in m.matrices %}
      {% if x.shards %}{% for s in x.shards %}
      <tr><td><a href="{{ s.path }}" download>{{ s.path }}</a></td><td class="wrap">{{ x.label or x.name }} shard {{ loop.index }}: {{ s.feature_min }} … {{ s.feature_max }}</td><td class="num">{{ "{:,}".format(s.rows or 0) }}</td><td class="num">{{ m.files[s.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[s.path].sha256 }}">{{ m.files[s.path].sha256[:12] }}…</td></tr>
      {% endfor %}{% else %}
      <tr><td><a href="{{ x.path }}" download>{{ x.path }}</a></td><td class="wrap">{{ x.label or x.name }} · {{ x.value.label or x.value.kind }} (obs_id, feature_id, value; sparse long table)</td><td class="num">{{ "{:,}".format(x.nnz or 0) }}</td><td class="num">{{ m.files[x.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[x.path].sha256 }}">{{ m.files[x.path].sha256[:12] }}…</td></tr>
      {% endif %}
    {% endfor %}
    {% for e in m.embeddings %}
      <tr><td><a href="{{ e.path }}" download>{{ e.path }}</a></td><td class="wrap">{{ e.label or e.name }} coordinates (obs_id, x, y)</td><td class="num">{{ "{:,}".format(obs.rows if obs else 0) }}</td><td class="num">{{ m.files[e.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[e.path].sha256 }}">{{ m.files[e.path].sha256[:12] }}…</td></tr>
    {% endfor %}
    {% for r in m.results %}
      <tr><td><a href="{{ r.path }}" download>{{ r.path }}</a></td><td class="wrap">{{ r.label }}{% if r.description %} · {{ r.description }}{% endif %}</td><td class="num">{{ "{:,}".format(r.rows or 0) }}</td><td class="num">{{ m.files[r.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[r.path].sha256 }}">{{ m.files[r.path].sha256[:12] }}…</td></tr>
    {% endfor %}
    {% for g in m.aggregates %}
      <tr><td><a href="{{ g.path }}" download>{{ g.path }}</a></td><td class="wrap">Aggregate: {{ g.description or g.name }}</td><td class="num"></td><td class="num">{{ m.files[g.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[g.path].sha256 }}">{{ m.files[g.path].sha256[:12] }}…</td></tr>
    {% endfor %}
    {% for f in m.figures %}{% for p in f.panels %}
      <tr><td><a href="{{ p.path }}" download>{{ p.path }}</a></td><td class="wrap">Source data: {{ f.label }} · {{ p.label }}</td><td class="num">{{ "{:,}".format(p.rows) }}</td><td class="num">{{ m.files[p.path].bytes | human_bytes }}</td><td class="id" title="{{ m.files[p.path].sha256 }}">{{ m.files[p.path].sha256[:12] }}…</td></tr>
    {% endfor %}{% endfor %}
    </tbody>
  </table></div>
</div>

{% if m.assets %}
<div class="card tight" style="margin-top:16px">
  <div class="card-head" style="padding:6px 6px 0"><h2>Original and external files</h2></div>
  <div class="table-wrap"><table class="data">
    <thead><tr><th>File</th><th>Kind</th><th class="num">Size</th><th>Checksum</th><th>Note</th></tr></thead>
    <tbody>{% for x in m.assets %}<tr><td><a href="{{ x.url }}">{{ x.label }}</a></td><td>{{ x.kind }}</td><td class="num">{{ x.bytes | human_bytes if x.bytes else '' }}</td><td class="id">{{ (x.sha256 or x.md5 or '')[:12] }}</td><td class="muted">{{ x.note or '' }}</td></tr>{% endfor %}</tbody>
  </table></div>
</div>
{% endif %}

<div class="card" style="margin-top:16px">
  <div class="card-head"><h2>Read the tables directly</h2></div>
  <div class="grid grid-2">
    {% if obs %}<div><h3>Python</h3><pre class="code">import pandas as pd
obs = pd.read_parquet("{{ obs.path }}")
expr = pd.read_parquet("{{ m.matrices[0].path if m.matrices else 'data/matrix.parquet' }}",
                       filters=[("feature_id", "==", "{{ portal.example_feature or 'GENE' }}")])</pre></div>
    <div><h3>R</h3><pre class="code">library(arrow)
obs  <- read_parquet("{{ obs.path }}")
expr <- open_dataset("{{ m.matrices[0].path if m.matrices else 'data/matrix.parquet' }}") |>
  dplyr::filter(feature_id == "{{ portal.example_feature or 'GENE' }}") |> dplyr::collect()</pre></div>
    {% else %}{% set p0 = m.figures[0].panels[0] if m.figures else none %}<div><h3>Python</h3><pre class="code">import pandas as pd
panel = pd.read_parquet("{{ p0.path if p0 else (m.tables.values() | list)[0].path }}")</pre></div>
    <div><h3>R</h3><pre class="code">library(arrow)
panel <- read_parquet("{{ p0.path if p0 else (m.tables.values() | list)[0].path }}")</pre></div>{% endif %}
  </div>
</div>
{% endblock %}
